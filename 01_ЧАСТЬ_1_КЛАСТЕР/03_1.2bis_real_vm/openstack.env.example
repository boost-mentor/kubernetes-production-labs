# Экспортируй реальные значения в текущую shell-сессию ИЗ secret manager.
# Этот файл — только список имён, значений и credentials здесь быть не должно.
export OS_AUTH_URL="https://cloud.api.selcloud.ru/identity/v3"
export OS_USER_ID="REPLACE"
export OS_PASSWORD="REPLACE"
export OS_PROJECT_ID="REPLACE"
export OS_REGION_NAME="REPLACE"
export OS_USER_DOMAIN_NAME="REPLACE"
export TF_VAR_flavor_id="REPLACE"
export TF_VAR_image_id="REPLACE"
export TF_VAR_network_id="REPLACE"
export TF_VAR_external_network_name="REPLACE"
export TF_VAR_ssh_public_key="$(cat ~/.ssh/video2_recording.pub)"
export TF_VAR_allowed_ingress_cidr="203.0.113.42/32"
export TF_VAR_ssh_user="ubuntu"
