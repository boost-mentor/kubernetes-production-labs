zone         = "ru-central1-a"
cluster_name = "k8s-managed"

# ⚠️ Другая подсеть, чем у self-managed кластера (10.10.0.0/24)
vpc_cidr           = "10.20.0.0/24"
cluster_ipv4_range = "10.112.0.0/16"   # Pod CIDR
service_ipv4_range = "10.96.0.0/16"    # Service CIDR

# Проверено 29.07.2026: 1.34 в канале STABLE, 1.35 пока только REGULAR
k8s_version     = "1.34"
release_channel = "STABLE"

node_count = 2

# В части 3 переключаем на true и показываем Cluster Autoscaler.
enable_autoscaling       = false
autoscaling_min_nodes    = 2
autoscaling_max_nodes    = 5

# Только текущий public IP ноутбука /32, не весь интернет.
allowed_nodeport_cidr = "203.0.113.42/32"
allowed_api_cidr      = "203.0.113.42/32"
