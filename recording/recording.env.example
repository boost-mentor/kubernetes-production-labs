# Copy to recording/.recording.env before REC and fill only local values.
# This file contains no credentials and is safe to commit.

VIDEO2_SSH_KEY="$HOME/Downloads/bmlab_key.pem"
VIDEO2_SSH_USER="root"
SELF_CONTEXT="kubespray"
MANAGED_CONTEXT="yc-managed"

# Public/floating SSH addresses shown by the ordinary BoostMentor lesson lab.
# Fill these after the single five-VM environment has started.  Kubespray and
# HAProxy backends use private addresses gathered by Ansible facts.
NODE1_SSH_HOST=""
NODE2_SSH_HOST=""
NODE3_SSH_HOST=""
LB1_SSH_HOST=""
LB2_SSH_HOST=""

# Fill only after the five VM exist.  Read the private subnet from facts and
# confirm the pool in the provider IPAM/DHCP settings; never infer a free pool
# from the node IPs alone.
NODE_SUBNET_CIDR=""
METALLB_POOL_START=""
METALLB_POOL_END=""

# Lab-only VIP inside the lb1/lb2 VXLAN. It is not a public cloud address.
HA_VIP="10.77.0.10"
HA_PORT="8080"
K8S_NODEPORT="30080"
